<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Krishnakumar | Portfolio</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- Header -->
    <header>
        <nav>
            <h2>Krishnakumar</h2>

            <div>
                <a href="#home">Home</a>
                <a href="#about">About</a>
                <a href="#skills">Skills</a>
                <a href="#projects">Projects</a>
                <a href="#education">Education</a>
                <a href="#contact">Contact</a>
            </div>
        </nav>
    </header>


    <!-- Home -->
    <section id="home">

        <div>
            <h1>Hi, I'm Krishnakumar</h1>

            <h3>Computer Science Engineering Student</h3>

            <p>
                Welcome to my professional portfolio.
                Here you can explore my skills, projects,
                education and interests in software development.
            </p>

            <a href="#projects" class="btn">View My Projects</a>
        </div>

    </section>


    <!-- About -->
    <section id="about">

        <h2>About Me</h2>

        <p>
            I am a Computer Science Engineering student interested
            in programming, software development and learning new
            technologies. I enjoy developing projects and improving
            my technical skills through practical experience.
        </p>

    </section>


    <!-- Skills -->
    <section id="skills">

        <h2>My Skills</h2>

        <div class="skills">

            <div class="skill">Java</div>
            <div class="skill">HTML</div>
            <div class="skill">CSS</div>
            <div class="skill">JavaScript</div>
            <div class="skill">MySQL</div>
            <div class="skill">Git & GitHub</div>

        </div>

    </section>


    <!-- Projects -->
    <section id="projects">

        <h2>My Projects</h2>

        <div class="projects">

            <div class="project">
                <h3>Currency Converter</h3>

                <p>
                    A Java-based currency conversion application
                    designed to convert values between different
                    currencies.
                </p>

            </div>


            <div class="project">
                <h3>Online Quiz Application</h3>

                <p>
                    A Java-based quiz application that allows users
                    to answer questions and view their results.
                </p>

            </div>


            <div class="project">
                <h3>Banking Application</h3>

                <p>
                    A Java-based banking management application
                    for handling basic banking operations.
                </p>

            </div>


            <div class="project">
                <h3>Vehicle Service Centre</h3>

                <p>
                    A web-based system for managing customers,
                    vehicles, service bookings and billing.
                </p>

            </div>

        </div>

    </section>


    <!-- Education -->
    <section id="education">

        <h2>Education</h2>

        <div class="education">

            <div class="education-item">

                <h3>B.E. Computer Science and Engineering</h3>

                <p>
                    Computer Science and Engineering
                </p>

            </div>

        </div>

    </section>


    <!-- Contact -->
    <section id="contact">

        <h2>Contact Me</h2>

        <div class="contact-info">

            <p>
                Email:
                <a href="mailto:your-email@example.com">
                    your-email@example.com
                </a>
            </p>

            <p>
                GitHub:
                <a href="https://github.com/" target="_blank">
                    GitHub Profile
                </a>
            </p>

        </div>

    </section>


    <!-- Footer -->
    <footer>

        <p>
            © <span id="year"></span> Krishnakumar.
            All Rights Reserved.
        </p>

    </footer>


    <script src="script.js"></script>

</body>
</html>
