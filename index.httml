<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="description"
          content="Krishna Kumar - Computer Science Engineering Student Portfolio">
    <meta name="keywords"
          content="Krishna Kumar, Computer Science, CSE, Web Developer, Portfolio, Student">
    <meta name="author" content="Krishna Kumar">

    <title>Krishna Kumar | CSE Student Portfolio</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- ================= HEADER ================= -->
    <header class="header">

        <a href="#home" class="logo">
            Krishna<span>.</span>
        </a>

        <nav class="navbar" id="navbar">
            <a href="#home" class="active">Home</a>
            <a href="#about">About</a>
            <a href="#skills">Skills</a>
            <a href="#education">Education</a>
            <a href="#projects">Projects</a>
            <a href="#certifications">Certificates</a>
            <a href="#contact">Contact</a>
        </nav>

        <div class="menu-icon" id="menu-icon">
            <i class="fa-solid fa-bars"></i>
        </div>

    </header>


    <!-- ================= HOME ================= -->
    <section class="home" id="home">

        <div class="home-content">

            <p class="welcome">WELCOME TO MY PORTFOLIO</p>

            <h1>
                Hi, I'm <span>Krishna Kumar</span>
            </h1>

            <h2>
                Computer Science Engineering Student
            </h2>

            <p>
                Passionate about technology, programming and web development.
                I enjoy creating practical solutions and learning new
                technologies to build useful digital applications.
            </p>

            <div class="home-buttons">

                <a href="#projects" class="btn">
                    View Projects
                    <i class="fa-solid fa-arrow-right"></i>
                </a>

                <a href="#contact" class="btn btn-outline">
                    Contact Me
                </a>

            </div>

            <div class="social-icons">

                <a href="https://github.com/nkrishnakumar223-ship-it"
                   target="_blank"
                   aria-label="GitHub">
                    <i class="fa-brands fa-github"></i>
                </a>

                <a href="#"
                   target="_blank"
                   aria-label="LinkedIn">
                    <i class="fa-brands fa-linkedin-in"></i>
                </a>

                <a href="mailto:yourmail@gmail.com"
                   aria-label="Email">
                    <i class="fa-solid fa-envelope"></i>
                </a>

            </div>

        </div>

        <div class="home-image">

            <div class="profile-circle">
                <div class="profile-content">
                    <i class="fa-solid fa-code"></i>
                    <h3>CSE</h3>
                    <p>Student</p>
                </div>
            </div>

        </div>

    </section>


    <!-- ================= ABOUT ================= -->
    <section class="about section" id="about">

        <div class="section-title">
            <p>GET TO KNOW ME</p>
            <h2>About <span>Me</span></h2>
        </div>

        <div class="about-container">

            <div class="about-card">

                <div class="about-icon">
                    <i class="fa-solid fa-user"></i>
                </div>

                <h3>Who I Am</h3>

                <p>
                    I am a Computer Science Engineering student with an
                    interest in software development, web technologies,
                    databases and problem solving.
                </p>

                <p>
                    My goal is to continuously improve my technical skills
                    and develop real-world applications that solve practical
                    problems.
                </p>

            </div>

            <div class="about-details">

                <div class="detail-item">
                    <i class="fa-solid fa-graduation-cap"></i>
                    <div>
                        <h4>Education</h4>
                        <p>Computer Science Engineering</p>
                    </div>
                </div>

                <div class="detail-item">
                    <i class="fa-solid fa-code"></i>
                    <div>
                        <h4>Interests</h4>
                        <p>Web Development & Programming</p>
                    </div>
                </div>

                <div class="detail-item">
                    <i class="fa-solid fa-lightbulb"></i>
                    <div>
                        <h4>Passion</h4>
                        <p>Learning New Technologies</p>
                    </div>
                </div>

                <div class="detail-item">
                    <i class="fa-solid fa-rocket"></i>
                    <div>
                        <h4>Goal</h4>
                        <p>Become a Skilled Software Developer</p>
                    </div>
                </div>

            </div>

        </div>

    </section>


    <!-- ================= SKILLS ================= -->
    <section class="skills section" id="skills">

        <div class="section-title">
            <p>WHAT I KNOW</p>
            <h2>My <span>Skills</span></h2>
        </div>

        <div class="skills-container">

            <div class="skill-card">
                <i class="fa-brands fa-html5"></i>
                <h3>HTML</h3>
                <p>Web Page Structure</p>
                <div class="skill-bar">
                    <span style="width: 90%"></span>
                </div>
                <small>90%</small>
            </div>

            <div class="skill-card">
                <i class="fa-brands fa-css3-alt"></i>
                <h3>CSS</h3>
                <p>Responsive Web Design</p>
                <div class="skill-bar">
                    <span style="width: 85%"></span>
                </div>
                <small>85%</small>
            </div>

            <div class="skill-card">
                <i class="fa-brands fa-js"></i>
                <h3>JavaScript</h3>
                <p>Interactive Web Applications</p>
                <div class="skill-bar">
                    <span style="width: 75%"></span>
                </div>
                <small>75%</small>
            </div>

            <div class="skill-card">
                <i class="fa-solid fa-database"></i>
                <h3>MySQL</h3>
                <p>Database Management</p>
                <div class="skill-bar">
                    <span style="width: 75%"></span>
                </div>
                <small>75%</small>
            </div>

            <div class="skill-card">
                <i class="fa-brands fa-node-js"></i>
                <h3>Node.js</h3>
                <p>Backend Development</p>
                <div class="skill-bar">
                    <span style="width: 70%"></span>
                </div>
                <small>70%</small>
            </div>

            <div class="skill-card">
                <i class="fa-solid fa-code"></i>
                <h3>C Programming</h3>
                <p>Programming & Logic</p>
                <div class="skill-bar">
                    <span style="width: 75%"></span>
                </div>
                <small>75%</small>
            </div>

        </div>

    </section>


    <!-- ================= EDUCATION ================= -->
    <section class="education section" id="education">

        <div class="section-title">
            <p>MY ACADEMIC JOURNEY</p>
            <h2>My <span>Education</span></h2>
        </div>

        <div class="timeline">

            <div class="timeline-item">

                <div class="timeline-icon">
                    <i class="fa-solid fa-graduation-cap"></i>
                </div>

                <div class="timeline-content">

                    <span>Current</span>

                    <h3>Bachelor's Degree</h3>

                    <h4>Computer Science Engineering</h4>

                    <p>
                        Currently pursuing Computer Science Engineering
                        and developing knowledge in programming, databases,
                        web development and software engineering.
                    </p>

                </div>

            </div>

            <div class="timeline-item">

                <div class="timeline-icon">
                    <i class="fa-solid fa-school"></i>
                </div>

                <div class="timeline-content">

                    <span>Completed</span>

                    <h3>Higher Secondary Education</h3>

                    <h4>School Education</h4>

                    <p>
                        Completed higher secondary education and developed
                        an interest in computer science and technology.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- ================= PROJECTS ================= -->
    <section class="projects section" id="projects">

        <div class="section-title">
            <p>MY RECENT WORK</p>
            <h2>My <span>Projects</span></h2>
        </div>

        <div class="projects-container">

            <!-- Project 1 -->
            <div class="project-card">

                <div class="project-image">
                    <i class="fa-solid fa-car"></i>
                </div>

                <div class="project-content">

                    <span class="project-number">01</span>

                    <h3>Vehicle Service Centre Management System</h3>

                    <p>
                        A web-based system designed to manage customers,
                        vehicles, service records and billing information
                        efficiently.
                    </p>

                    <div class="project-tech">
                        <span>HTML</span>
                        <span>CSS</span>
                        <span>JavaScript</span>
                        <span>Node.js</span>
                        <span>MySQL</span>
                    </div>

                    <a href="#" class="project-link">
                        View Project
                        <i class="fa-solid fa-arrow-up-right-from-square"></i>
                    </a>

                </div>

            </div>


            <!-- Project 2 -->
            <div class="project-card">

                <div class="project-image">
                    <i class="fa-solid fa-chart-line"></i>
                </div>

                <div class="project-content">

                    <span class="project-number">02</span>

                    <h3>Data Analytics Project</h3>

                    <p>
                        A project focused on analyzing data and presenting
                        useful information through organized reports and
                        visualizations.
                    </p>

                    <div class="project-tech">
                        <span>Python</span>
                        <span>Data Analysis</span>
                        <span>Excel</span>
                    </div>

                    <a href="#" class="project-link">
                        View Project
                        <i class="fa-solid fa-arrow-up-right-from-square"></i>
                    </a>

                </div>

            </div>


            <!-- Project 3 -->
            <div class="project-card">

                <div class="project-image">
                    <i class="fa-solid fa-globe"></i>
                </div>

                <div class="project-content">

                    <span class="project-number">03</span>

                    <h3>Personal Portfolio Website</h3>

                    <p>
                        A responsive personal portfolio website created to
                        showcase my education, skills, projects,
                        certifications and achievements.
                    </p>

                    <div class="project-tech">
                        <span>HTML</span>
                        <span>CSS</span>
                        <span>JavaScript</span>
                        <span>GitHub Pages</span>
                    </div>

                    <a href="#" class="project-link">
                        Current Website
                        <i class="fa-solid fa-arrow-up-right-from-square"></i>
                    </a>

                </div>

            </div>

        </div>

    </section>


    <!-- ================= CERTIFICATIONS ================= -->
    <section class="certifications section" id="certifications">

        <div class="section-title">
            <p>MY ACHIEVEMENTS</p>
            <h2>Certificates & <span>Achievements</span></h2>
        </div>

        <div class="certificate-container">

            <div class="certificate-card">

                <div class="certificate-icon">
                    <i class="fa-solid fa-certificate"></i>
                </div>

                <div>
                    <h3>Computer Science Certification</h3>
                    <p>Add your certificate name here</p>
                    <span>Certificate</span>
                </div>

            </div>

            <div class="certificate-card">

                <div class="certificate-icon">
                    <i class="fa-solid fa-award"></i>
                </div>

                <div>
                    <h3>Web Development</h3>
                    <p>Add your certification details here</p>
                    <span>Certification</span>
                </div>

            </div>

            <div class="certificate-card">

                <div class="certificate-icon">
                    <i class="fa-solid fa-trophy"></i>
                </div>

                <div>
                    <h3>Academic Achievement</h3>
                    <p>Add your achievement details here</p>
                    <span>Achievement</span>
                </div>

            </div>

        </div>

    </section>


    <!-- ================= CONTACT ================= -->
    <section class="contact section" id="contact">

        <div class="section-title">
            <p>LET'S CONNECT</p>
            <h2>Contact <span>Me</span></h2>
        </div>

        <div class="contact-container">

            <div class="contact-info">

                <h3>Let's Work Together</h3>

                <p>
                    If you would like to connect with me, discuss a project,
                    or share an opportunity, feel free to contact me.
                </p>

                <div class="contact-item">
                    <i class="fa-solid fa-envelope"></i>
                    <div>
                        <h4>Email</h4>
                        <a href="mailto:yourmail@gmail.com">
                            yourmail@gmail.com
                        </a>
                    </div>
                </div>

                <div class="contact-item">
                    <i class="fa-brands fa-github"></i>
                    <div>
                        <h4>GitHub</h4>
                        <a href="https://github.com/nkrishnakumar223-ship-it"
                           target="_blank">
                            GitHub Profile
                        </a>
                    </div>
                </div>

                <div class="contact-item">
                    <i class="fa-brands fa-linkedin"></i>
                    <div>
                        <h4>LinkedIn</h4>
                        <a href="#" target="_blank">
                            LinkedIn Profile
                        </a>
                    </div>
                </div>

            </div>


            <form class="contact-form" id="contact-form">

                <div class="input-group">

                    <input type="text"
                           id="name"
                           placeholder="Your Name"
                           required>

                    <input type="email"
                           id="email"
                           placeholder="Your Email"
                           required>

                </div>

                <input type="text"
                       id="subject"
                       placeholder="Subject"
                       required>

                <textarea id="message"
                          rows="7"
                          placeholder="Your Message"
                          required></textarea>

                <button type="submit" class="btn">
                    Send Message
                    <i class="fa-solid fa-paper-plane"></i>
                </button>

            </form>

        </div>

    </section>


    <!-- ================= FOOTER ================= -->
    <footer class="footer">

        <div class="footer-content">

            <h2>Krishna<span>.</span></h2>

            <p>
                Computer Science Engineering Student | Developer | Learner
            </p>

            <div class="footer-social">

                <a href="https://github.com/nkrishnakumar223-ship-it"
                   target="_blank">
                    <i class="fa-brands fa-github"></i>
                </a>

                <a href="#" target="_blank">
                    <i class="fa-brands fa-linkedin-in"></i>
                </a>

                <a href="mailto:yourmail@gmail.com">
                    <i class="fa-solid fa-envelope"></i>
                </a>

            </div>

        </div>

        <div class="footer-bottom">
            <p>
                © <span id="year"></span> Krishna Kumar.
                All Rights Reserved.
            </p>
        </div>

    </footer>


    <!-- Scroll to top -->
    <button id="scroll-top" title="Go to top">
        <i class="fa-solid fa-arrow-up"></i>
    </button>

    <script src="script.js"></script>

</body>
</html>
